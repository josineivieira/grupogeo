# Supabase: use the transaction pooler (port 6543) at runtime.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Supabase: use the direct/session connection (port 5432) for Prisma migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
POSTGRES_USER=geo
POSTGRES_PASSWORD=change_me
POSTGRES_DB=geo_rh
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
PORT=3001
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GEO RH <rh@example.com>
WEB_URL=http://localhost:3000
